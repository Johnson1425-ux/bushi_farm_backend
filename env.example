# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=milktrack
DB_USER=postgres
DB_PASSWORD=your_password_here

# Server
PORT=3001

# Anthropic (AI reports)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5

# Sessions
# The key access tokens are signed with. Required in production — the server
# refuses to start without it rather than signing with a key that is in the
# repository. Generate one with:  openssl rand -hex 32
JWT_SECRET=

# How long an access token lives, in seconds (default 900 = 15 minutes).
# This is the window in which a revoked session still works, so shorter is
# safer and costs only a background refresh call.
ACCESS_TOKEN_SECONDS=900

# How long a session survives without signing in again, in days (default
# 30). The session limit below is shorter, so this is only an outer bound.
REFRESH_TOKEN_DAYS=30

# Sign out a session left unused this long, in minutes (default 30). A
# till abandoned at the end of a shift stops being signed in. Nothing in
# the app polls, so "unused" means nobody has touched it. Measured from
# when the session last renewed, which is why the real window runs a
# little over this — with a 15-minute access token, between 30 and about
# 38 minutes. Never under it.
SESSION_IDLE_MINUTES=30

# The longest one sign-in may last however busy it is, in hours (default
# 12). Outlasts a shift and not much else, so a counter is handed over
# with a sign-in rather than with whoever opened it that morning.
SESSION_MAX_HOURS=12

# How long after a refresh token is rotated the old one is still forgiven,
# in seconds (default 30). Two browser tabs renewing in the same moment
# both present the token one of them just spent; inside this window that
# is treated as the race it is, and outside it as the replay it looks
# like, which ends the session. Rarely worth changing.
REFRESH_REUSE_LEEWAY_SECONDS=30

# Where the refresh cookie may be sent. Unset means 'lax' in development
# and 'none' in production, which works whichever way the app reaches the
# API — so it is safe to leave alone while a deployment changes shape.
#
# The app proxies /api through its own domain (its vercel.json), so the
# cookie is first-party and 'lax' is the right setting: it keeps the
# cookie off cross-site requests entirely, one more layer under the
# origin check. Set it to 'lax' once that proxy is confirmed live —
# anything still calling this API directly from another site will stop
# being able to hold a session, which is the intended effect.
COOKIE_SAMESITE=

# Only for app and API on two hosts under one parent domain, e.g.
# '.yourfarm.com'. Leave unset otherwise and the cookie stays bound to the
# host that set it.
COOKIE_DOMAIN=

# Extra browser origins allowed to call this API, comma separated. The
# app's own domain goes here once it has one.
EXTRA_ALLOWED_ORIGINS=
